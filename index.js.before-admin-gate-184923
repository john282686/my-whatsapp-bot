var keyCooldown = {};

function getNextKey(provider) {
    var keys = KEY_POOL[provider];
    if (!keys || keys.length === 0) return null;
    var now = Date.now();
    for (var i = 0; i < keys.length; i++) {
        var keyId = provider + ":" + i;
        if (!keyCooldown[keyId] || keyCooldown[keyId] < now) {
            return { key: keys[i], index: i };
        }
    }
    return null;
}

function markKeyFailed(provider, index) {
    var now = Date.now();
    keyCooldown[provider + ":" + index] = now + (24 * 60 * 60 * 1000);
    console.log('[KEY] ' + provider + ' key#' + index + ' cooling 24h');
}

function markKeyOk(provider, index) {
    delete keyCooldown[provider + ":" + index];
}

