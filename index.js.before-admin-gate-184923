function hasLink(text) {
    if (!text) return false;
    var t = String(text).toLowerCase();
    if (t.includes('http://') || t.includes('https://') || t.includes('www.')) return true;
    var exts = ['com','net','org','io','co','me','tv','xyz','top','online','site','app','dev','ai','info','biz','link','click','ng','gh','ke','za','uk','us','ru','in','tk','ml','ga','cf','gq','club','live','shop','tech','store','space','cloud','info'];
    for (var i=0;i<exts.length;i++) if (t.includes('.' + exts[i])) return true;
    return false;
}

